import java.util.ArrayList;

import javax.print.DocFlavor.STRING;
public class Snake {
  private final int CELL_SIZE = 10;      // Größe eines Pixels/Zelle
  private final int GRID_WIDTH = 24;     // Anzahl der Zellen horizontal
  private final int GRID_HEIGHT = 14;   // Anzahl der Zellen vertikal
  private ArrayList<SnakeSegment> body;  
  private int pixelY = 0;
  private int pixelX = 0;
  private int FoodX = (int) (Math.random() * GRID_WIDTH );
  private int FoodY = (int) (Math.random() * GRID_HEIGHT );
  private int score = 0;
  private int highscore = 0;
  // objekt ertsllen 
  SnakeSegment head = new SnakeSegment(pixelX,pixelY); 
  
  
  
  //konstruktor 
  public Snake(){
    body = new ArrayList<>();
    body.add(head);    
    makeFood(); 
  }
  //methoden
  public ArrayList<SnakeSegment> getBody() {
    return body;
  }

  public int getFoodX(){
    return FoodX;
  }
  public int getFoodY(){
    return FoodY;
  }

//essen erzeugen 
  public void makeFood(){
    FoodX = (int) (Math.random() * GRID_WIDTH );
    FoodY = (int) (Math.random() * GRID_HEIGHT );
  }
// essen gegegensen überprüfen return true/false
  public boolean Foodate(int x, int y){
    return (x == FoodX && y == FoodY);
  }
  
  public boolean hitWall() {
    // Prüft, ob der Kopf über den Spielfeldrand hinausgeht
    return pixelX < 0 || pixelX >= GRID_WIDTH  ||
    pixelY < 0 || pixelY >= GRID_HEIGHT ;
  }

  

  // methode zum bewegen der schlange 

  public void moveSnake(String direction){
    //methode zum bewegen der schlange 
    
    
    if (!hitWall()) {
      switch (direction) {
        case "UP" ->pixelY--; 
        case "DOWN" ->pixelY++; 
        case "LEFT" ->pixelX--; 
        case "RIGHT" ->pixelX++; 
      }
    } // end of if
    
    //neues segment hinzufügen 
    // also neues objet ertsellen mit new Snakesgement hier !!! wird vorne angeängt
    SnakeSegment Neu = new SnakeSegment(pixelX,pixelY);
    body.add(0,Neu);
    
    
    
    
    if (Foodate(pixelX, pixelY)) {
      makeFood();
      score = score + 1;
    } else {
      //letztes teil entfernenne wenn essen nicht gegegessen
      body.remove(body.size() - 1);
      System.out.println(body.size());
      
    }
    
    
  } //move ende
  
  public int getScore() {
    System.out.println("Score: " + score);
    return score;
  }
  
  public int getHighscore(){
    if (score > highscore) {
      highscore++;
    } // end of if
    System.out.println("Highscore " + highscore);
    return highscore; 
  }
  
  public void restart(){
    body.clear();
    //startposition einnehmen
    pixelX = 0;
    pixelY = 0;
    body.add(new SnakeSegment(pixelX,pixelY));
    
    score = 0;
    makeFood();
    
    } 
  } // end of class Snake
  